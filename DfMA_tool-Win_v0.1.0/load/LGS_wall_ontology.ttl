:Floor a owl:Class ;
    rdfs:subClassOf :Building_element .

:Roof a owl:Class ;
    rdfs:subClassOf :Building_element .

:Wall a owl:Class ;
    rdfs:subClassOf :Building_element .

:hasAngleXY a owl:DatatypeProperty ;
    rdfs:domain :Geometric_Information ;
    rdfs:range xsd:float .

:hasAttribute a owl:ObjectProperty ;
    rdfs:domain :Structural_element ;
    rdfs:range :Attribute .

:hasAxesClose a owl:DatatypeProperty ;
    rdfs:domain :Connection ;
    rdfs:range xsd:float .

:hasConnectionAngleDeg a owl:DatatypeProperty ;
    rdfs:domain :Connection ;
    rdfs:range xsd:float .

:hasContactX a owl:DatatypeProperty ;
    rdfs:domain :Connection ;
    rdfs:range xsd:float .

:hasContactY a owl:DatatypeProperty ;
    rdfs:domain :Connection ;
    rdfs:range xsd:float .

:hasContactZ a owl:DatatypeProperty ;
    rdfs:domain :Connection ;
    rdfs:range xsd:float .

:hasGapDistance a owl:DatatypeProperty ;
    rdfs:domain :Connection ;
    rdfs:range xsd:float .

:hasGeometricInformation a owl:ObjectProperty ;
    rdfs:domain :Structural_element ;
    rdfs:range :Geometric_Information .

:hasHeight a owl:DatatypeProperty ;
    rdfs:domain :Geometric_Information ;
    rdfs:range xsd:float .

:hasIntersection a owl:ObjectProperty ;
    rdfs:domain :Structural_element ;
    rdfs:range :Connection ;
    owl:inverseOf :connectsElement .

:hasLength a owl:DatatypeProperty ;
    rdfs:domain :Geometric_Information ;
    rdfs:range xsd:float .

:hasLengthToWidthRatio a owl:DatatypeProperty ;
    rdfs:domain :Geometric_Information ;
    rdfs:range xsd:float .

:hasName a owl:DatatypeProperty ;
    rdfs:domain :Project_information ;
    rdfs:range xsd:string .

:hasNetCrossSectionalArea a owl:DatatypeProperty ;
    rdfs:domain :Geometric_Information ;
    rdfs:range xsd:float .

:hasNumberofConnection a owl:DatatypeProperty ;
    rdfs:domain :Connection ;
    rdfs:range xsd:integer .

:hasOverlapX a owl:DatatypeProperty ;
    rdfs:domain :Connection ;
    rdfs:range xsd:float .

:hasOverlapY a owl:DatatypeProperty ;
    rdfs:domain :Connection ;
    rdfs:range xsd:float .

:hasOverlapZ a owl:DatatypeProperty ;
    rdfs:domain :Connection ;
    rdfs:range xsd:float .

:hasProjectInformation a owl:ObjectProperty ;
    rdfs:domain :Structural_element ;
    rdfs:range :Project_information .

:hasStorey a owl:DatatypeProperty ;
    rdfs:domain :Project_information ;
    rdfs:range xsd:string .

:hasTag a owl:DatatypeProperty ;
    rdfs:domain :Project_information ;
    rdfs:range xsd:string .

:hasThickness a owl:DatatypeProperty ;
    rdfs:domain :Geometric_Information ;
    rdfs:range xsd:float .

:hasWidth a owl:DatatypeProperty ;
    rdfs:domain :Geometric_Information ;
    rdfs:range xsd:float .

:hasX a owl:DatatypeProperty ;
    rdfs:domain :Geometric_Information ;
    rdfs:range xsd:float .

:hasY a owl:DatatypeProperty ;
    rdfs:domain :Geometric_Information ;
    rdfs:range xsd:float .

:hasZ a owl:DatatypeProperty ;
    rdfs:domain :Geometric_Information ;
    rdfs:range xsd:float .

:requiresOperation a owl:ObjectProperty ;
    rdfs:domain :Connection ;
    rdfs:range :Operation .

